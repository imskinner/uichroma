{
  "name": "@uichroma/core",
  "version": "1.0.0",
  "description": "UI Chroma shared color & theme engine — single source of truth for color math, palette validation/scoring, and the GPT-4o generation + critique pipeline.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./color": {
      "types": "./dist/cjs/color.d.ts",
      "import": "./dist/esm/color.js",
      "require": "./dist/cjs/color.js"
    },
    "./tokens": {
      "types": "./dist/cjs/tokens.d.ts",
      "import": "./dist/esm/tokens.js",
      "require": "./dist/cjs/tokens.js"
    },
    "./constraints": {
      "types": "./dist/cjs/constraints.d.ts",
      "import": "./dist/esm/constraints.js",
      "require": "./dist/cjs/constraints.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/fixup.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "uichroma": "file:../.."
  }
}
