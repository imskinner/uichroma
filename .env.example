# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- OpenAI ---
API_KEY=                      # OpenAI API key used by the palette generation + critique calls

# --- Supabase (server-side persistence) ---
# The app now stores themes in Supabase. The service-role key is server-side ONLY (it bypasses
# Row-Level Security) — never expose it to the client. Set these in .env (local) and in the
# Vercel project env (production).
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # service_role key (server-side only — keep secret)
SUPABASE_ANON_KEY=            # anon/public key (for future client-side reads; Phase 3)

# --- Firebase Admin (read-only, for the one-time migration only) ---
# Only needed to run `npm run migrate` (Firestore -> Supabase). Provide ONE of these.
# Once the migration is verified, Firebase can be removed entirely.
FIREBASE_SERVICE_ACCOUNT=     # The full service-account JSON as a single-line string
# GOOGLE_APPLICATION_CREDENTIALS=  # ...or an absolute path to a service-account key file

# --- Firebase Web (client) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Rate limiting (stopgap, in-memory) ---
RATE_LIMIT_WINDOW_MS=60000    # window size in ms (default 60000)
RATE_LIMIT_MAX=10             # max /generatePalette requests per IP per window (default 10)

# --- Server ---
PORT=3000
