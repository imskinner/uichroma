# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- OpenAI ---
API_KEY=                      # OpenAI API key used by the palette generation + critique calls

# --- Firebase Admin (server-side) ---
# Provide ONE of the following. Credentials are loaded from the environment only —
# do NOT commit a service-account JSON file to the repo.
FIREBASE_SERVICE_ACCOUNT=     # The full service-account JSON as a single-line string (Vercel-friendly)
# GOOGLE_APPLICATION_CREDENTIALS=  # ...or an absolute path to a service-account key file (local dev)

# --- Firebase Web (client) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Rate limiting (stopgap, in-memory) ---
RATE_LIMIT_WINDOW_MS=60000    # window size in ms (default 60000)
RATE_LIMIT_MAX=10             # max /generatePalette requests per IP per window (default 10)

# --- Server ---
PORT=3000
