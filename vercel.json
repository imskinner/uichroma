{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/.*",
        "dest": "server.js"
      }
    ],
    "env": {
        "POSTGRES_URL": "@POSTGRES_URL",
        "API_KEY": "@API_KEY"
      }
  }