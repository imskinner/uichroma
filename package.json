{
    "name": "uichroma",
    "version": "1.0.0",
    "description": "UI Chroma - Color Palette Generator",
    "main": "server.js",
    "workspaces": [
        "packages/*",
        "apps/*",
        "client"
    ],
    "scripts": {
        "build:core": "npm --prefix packages/core run build",
        "build:mcp": "npm --prefix packages/core run build && npm --prefix apps/mcp run build",
        "start": "node server.js",
        "prestart": "npm run build:core",
        "dev:server": "nodemon server.js",
        "dev:client": "npm --prefix client run dev",
        "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
        "predev": "npm run build:core",
        "build": "npm run build:core && npm --prefix client run build",
        "migrate": "node scripts/migrate-firestore-to-supabase.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "firebase-admin": "^13.7.0",
        "node-fetch": "^2.7.0"
    },
    "devDependencies": {
        "concurrently": "^8.0.1",
        "nodemon": "^3.0.1"
    },
    "engines": {
        "node": "22.x"
    }
}
