{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "app" },
      { "source": "/generatePalette", "function": "app" },
      { "source": "/palette/**/data", "function": "app" },
      { "source": "/palette/**", "destination": "/palette.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" install"]
  }
} 